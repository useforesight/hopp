{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "hopp",
  "title": "Hopp",
  "description": "Call a teammate on Hopp by typing their name.",
  "icon": "hopp.png",
  "author": "useforesight",
  "license": "AGPL-3.0-only",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Communication"
  ],
  "commands": [
    {
      "name": "call",
      "title": "Call Teammate",
      "subtitle": "Hopp",
      "description": "Type a teammate's name and press return to call them on Hopp.",
      "mode": "view",
      "keywords": [
        "hopp",
        "ring",
        "pair",
        "dial"
      ],
      "arguments": [
        {
          "name": "name",
          "type": "text",
          "placeholder": "Name",
          "required": false
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.10.1",
    "@raycast/utils": "^2.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.8.0"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "test": "node --test src/directory.test.ts"
  }
}
