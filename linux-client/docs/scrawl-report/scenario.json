  "lines": [
    {
      "who": "alex",
      "at": 1.5,
      "until": 6.69,
      "text": "Okay, I'm sharing the checkout page. Something is off with the order total."
    },
    {
      "who": "sam",
      "at": 7.0,
      "until": 11.3,
      "text": "Yeah, look here. The discount is applied, but the total is still one hundred and twenty."
    },
    {
      "who": "alex",
      "at": 13.5,
      "until": 18.74,
      "text": "Right. And the discount line itself looks correct. Twelve pounds off."
    },
    {
      "who": "sam",
      "at": 19.0,
      "until": 22.69,
      "text": "Let me drop a pin on the coupon field too. That's where save ten goes in."
    },
    {
      "who": "alex",
      "at": 25.0,
      "until": 28.51,
      "text": "Here's the total function in cart dot T S."
    },
    {
      "who": "sam",
      "at": 30.0,
      "until": 33.4,
      "text": "This line here returns the subtotal. It never subtracts the discount."
    },
    {
      "who": "alex",
      "at": 37.5,
      "until": 41.46,
      "text": "Hey Claude, can you confirm that's the bug, and tell us the fix?"
    },
    {
      "who": "sam",
      "at": 44.0,
      "until": 46.75,
      "text": "I'll bookmark this. The total ignores the discount."
    },
    {
      "who": "alex",
      "at": 50.0,
      "until": 53.52,
      "text": "Okay, I've changed it to subtract the discount."
    },
    {
      "who": "alex",
      "at": 55.5,
      "until": 60.0,
      "text": "And the checkout total now shows one hundred and eight pounds."
    },
    {
      "who": "sam",
      "at": 60.0,
      "until": 61.46,
      "text": "Nice, that's right now. Ship it."
    }
  ]
}